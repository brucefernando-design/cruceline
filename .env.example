# Configuración de Producción / Desarrollo CruceLine
# En producción, genera una clave segura (ej: openssl rand -hex 32)
CRUCELINE_SECRET=cambia-esta-clave-secreta-larga-en-produccion-123456789

# Entorno: development | production
CRUCELINE_ENV=development

# Forzar cookies seguras con HTTPS (1 en producción con certificado SSL)
CRUCELINE_HTTPS=0

# Puerto del servidor (127.0.0.1:5055 en VPS)
PORT=5055

# Ruta persistente de base de datos SQLite (por defecto en data/cruceline.db)
CRUCELINE_DB=./data/cruceline.db

# Cargar datos de prueba (Transportes del Bravo). Poner en 0 en producción.
CRUCELINE_SEED=1

# Código de invitación obligatorio para registrar nuevas empresas en la plataforma.
# Si está vacío en producción, el registro público queda bloqueado (403).
CRUCELINE_INVITE_CODE=PILOTO2026
